# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. Everything works without them (in-memory data + sample plans).

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.6-flash, auto-falls back to gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (free plan) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
